# Скопируй в .env (make это сделает сам): cp .env.example .env

# Postgres (общие креды для БД приложения и БД Keycloak)
POSTGRES_USER=developer
POSTGRES_PASSWORD=developer
POSTGRES_DB=developer

# MinIO
MINIO_ROOT_USER=developer
MINIO_ROOT_PASSWORD=developer

# Keycloak (app container uses network_mode host, so localhost is shared with the browser)
# bootstrap (temporary) admin — used once by the init script to create the permanent admin
KC_BOOTSTRAP_ADMIN_USERNAME=temp
KC_BOOTSTRAP_ADMIN_PASSWORD=temp
# permanent admin — created by the init script; the app uses it for the Keycloak Admin API
KEYCLOAK_ADMIN_NAME=developer
KEYCLOAK_ADMIN_PASSWORD=developer
KC_HOSTNAME=http://localhost:9090

# Firebase Cloud Messaging (push). Leave empty to keep push disabled.
# Secret: path (inside the app container) to the service-account JSON for server-side sending.
FIREBASE_SERVICE_ACCOUNT=
# Public web-app config + VAPID public key (safe to expose to the browser).
FIREBASE_VAPID_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
